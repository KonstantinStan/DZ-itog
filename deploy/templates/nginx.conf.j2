
events {
    worker_connections 1024;
}

http {
    upstream audit_backend {
        server audit-svc:8080;
    }

    server {
        listen 8088;

        # Block requests to the internal reload endpoint.
        location ~* ^/+reload(?:/|$) {
            return 404;
        }

        location / {
            proxy_pass http://audit_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }

    # Internal status endpoint for Prometheus exporter.
    server {
        listen 8089;

        location = /stub_status {
            stub_status;
            access_log off;
            allow all;
        }

        location / {
            return 404;
        }
    }
}
